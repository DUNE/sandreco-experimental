{
    "ufw" : {
      "ufw-loglevel" : "debug",
      "ufw-basepath" : "/usr/local/share/sandreco/data",
      "ufw-ldpath" : ["/usr/local/lib64"],
      "ufw-env" : {}
    },
    "globals" : {
    },
    "contexts" : {
      "keys" :  [10,11,15],
      "locals" : {}
    },
    "run" : [
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/volumereco.root",
          "tree" : "recos"
        },
        "read" : ["lightmap"]
      },
      {
        "sand::grain::voxels_to_point_cloud" : {
          "dist_wall" : 1.1,
          "amp_thr" : 0.3
        },
        "reqs" : {"photon_amplitudes" : "lightmap"},
        "prods" : {"point_cloud": "point_cloud"}
      },
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/grain_point_cloud.root",
          "tree" : "point_cloud"
        },
        "write" : [ "point_cloud" ]
      }
    ]
  }