{
    "ufw" : {
      "ufw-loglevel" : "debug",
      "ufw-basepath" : "/usr/local/share/sandreco/data",
      "ufw-ldpath" : ["/usr/local/lib64"],
      "ufw-env" : {}
    },
    "globals" : {
    "sand::cl::platform" : {},
    "sand::root_tgeomanager" : { "geometry" : "test/SAND_opt3_DRIFT1.sand-events-in-sand_inner_volume.2.edep.root" },
    "sand::geoinfo" : { "grain" : { "inner_geometry" : "gdml-masks" } },
    "sand::grain::geant_gdml_parser" : {
      "gdml-masks" : { "path" : "geometries/grain/grain-masks/main.gdml" }
    },
    "sand::hdf5::ndarray" : {
      "angle_reader" : {
        "uri" : "test/voxel_weights.h5",
        "io" : "read"
      },
      "score_writer" : {
        "uri" : "test/volumereco.h5",
        "io" : "overwrite"
      }
    }
    },
    "contexts" : {
      "keys" :  [10,11,15,16],
      "locals" : {}
    },
    "run" : [
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/images.root",
          "tree" : "cameras"
        },
        "read" : ["grain_images"]
      },
      {
        "sand::grain::volumereco" : {
          "voxel_size" : 150.0,
          "max_iterations" : 3,
          "pde" : 1.0
        },
        "reqs" : { "images" : "grain_images" },
        "prods" : { "photon_amplitudes" : "grain_lightmap" }
      },
      {
        "sand::test::test_grain_volumereco" : {
          "voxel_size" : 150.0
        },
        "reqs" : {"photon_amplitudes": "grain_lightmap"},
        "prods" : {}
      },     
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/volumereco.root",
          "tree" : "recos"
        },
        "write" : ["grain_lightmap"]
      }
    ]
  }
  
