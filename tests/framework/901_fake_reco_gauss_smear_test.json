{
  "ufw": {
    "ufw-loglevel": "debug",
    "ufw-basepath": "/usr/local/share/sandreco/data",
    "ufw-ldpath": ["/usr/local/lib64"],
    "ufw-env": {}
  },
  "globals": {
    "sand::root_tgeomanager": {
      "geometry": "test/sand-spills.5.edep.root"
    }
  },
  "contexts": {
    "keys": 2,
    "locals": {
      "sand::edep_reader": {
        "uri": "test/sand-spills.5.edep.root"
      },
      "sand::genie_reader": {
        "uri": "test/sand-spills.5.edep.root"
      }
    }
  },
  "run": [
    {
      "sand::common::truth_filler": {},
      "reqs": {},
      "prods": {
        "out_truth_branch": "produced_truth"
      }
    },
    {
      "sand::fake_reco": {
        "mode" : "gauss_smearing",
        "energy_resolution" : 0.057,
        "momentum_resolution" : 0.03,
        "x_resolution" : 200e-3,
        "y_resolution" : 200e-3,
        "z_resolution" : 200e-3
      },
      "reqs": {
        "in_truth": "produced_truth"
      },
      "prods": {
        "output_caf": "produced_caf"
      }
    },
    {
      "sand::caf::caf_streamer": {
        "uri": "test/output.caf.root",
        "tree": "cafTree"
      },
      "write": ["produced_caf"]
    }
  ]
}
