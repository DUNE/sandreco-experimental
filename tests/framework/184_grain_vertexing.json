{
    "ufw" : {
      "ufw-loglevel" : "debug",
      "ufw-basepath" : "/usr/local/share/sandreco/data",
      "ufw-ldpath" : ["/usr/local/lib64"],
      "ufw-env" : {}
    },
    "globals" : {
    },
    "contexts" : {
      "keys" :  [10,11,15,16],
      "locals" : {}
    },
    "run" : [
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/grain_fitted_clusters.root",
          "tree" : "point_clusters"
        },
        "read" : ["grain_fitted_point_clusters"]
      },
      {
        "sand::grain::vertexing" : {
        },
        "reqs" : {"point_clusters" : "grain_fitted_point_clusters"},
        "prods" : {"vertices" : "grain_vertices"}
      },
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/grain_vertices.root",
          "tree" : "vertices"
        },
        "write" : ["grain_vertices"]
      }
    ]
  }
