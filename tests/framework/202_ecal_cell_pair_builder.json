          0.0,
          -0.087266463,
          0.087266463
        ],
        "drift_view_offset": [
          10.0,
          10.0,
          10.0
        ],
        "drift_view_spacing": [
          10.0,
          10.0,
          10.0
        ]
      },
      "sand::grain::geant_gdml_parser": {
        "gdml-masks": {
          "path": "geometries/grain/grain-masks/main.gdml"
        },
