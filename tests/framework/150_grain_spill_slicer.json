{
  "ufw" : {
    "ufw-loglevel" : "debug",
    "ufw-basepath" : "/usr/local/share/sandreco/data",
    "ufw-ldpath" : ["/usr/local/lib64"]
  },
  "globals" : {
    "sand::root_tgeomanager" : { "geometry" : "test/SAND_opt3_DRIFT1.sand-events-in-sand_inner_volume.2.edep.root" },
    "sand::geoinfo" : { "grain" : { "inner_geometry" : "gdml-masks" } },
      "sand::grain::geant_gdml_parser" : {
        "gdml-masks" : { "path" : "geometries/grain/grain-masks_3mm_32x32/main.gdml" }
      }
  },
  "contexts" : {
    "keys" : [0, 8, 15, 67],
    "locals" : {
    }
  },
  "run" : [
    {
      "sand::root::tree_streamer" : {
        "uri" : "test/detresp_masks.root",
        "tree" : "cameras"
      },
      "read" : [ "grain_digi" ]
    },
    {
      "sand::grain::spill_slicer" : {
          "min_response_signal": 8,
          "delta_ns_for_comparison": 1000
      },
      "reqs" : {"digi" : "grain_digi"},
        "prods" : {"images": "grain_images", "timeranges": "grain_timeranges"}
    },
    {
      "sand::test::test_grain_spill_slicer" : {},
        "reqs" : {"images": "grain_images", "timeranges": "grain_timeranges"},
      "prods" : {}
      },
    {
      "sand::root::tree_streamer" : {
        "uri" : "test/images_masks.root",
        "tree" : "cameras"
      },
        "write" : ["grain_images", "grain_timeranges"]
    },
    {
      "sand::png::png_streamer" : {
        "uri" : "/home/sand/sandreco-experimental/data/"
      },
        "write" : ["grain_images"]
    }
  ]
}

