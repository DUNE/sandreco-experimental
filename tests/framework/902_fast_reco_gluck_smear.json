{
  "ufw": {
    "ufw-loglevel": "debug",
    "ufw-basepath": "/usr/local/share/sandreco/data",
    "ufw-ldpath": ["/usr/local/lib64"],
    "ufw-env": {}
  },
  "globals": {
    "sand::root_tgeomanager": {
      "geometry": "test/sand-spills.5.edep.root"
    }
  },
  "contexts": {
    "keys": 2,
    "locals": {
      "sand::edep_reader": {
        "uri": "test/sand-spills.5.edep.root"
      },
      "sand::genie_reader": {
        "uri": "test/sand-spills.5.edep.root"
      },
      "sand::spill_maps": {}
    }
  },
  "run": [
    {
      "sand::common::truth_filler": {},
      "reqs": {},
      "prods": {
        "out_truth_branch": "produced_truth"
      }
    },
    {
      "sand::fast::tracker::reco": {
        "min_energy_deposit": 0.04
      },
      "reqs": {
        "in_truth": "produced_truth"
      },
      "prods": {
        "out_tracker": "produced_tracker"
      }
    },
    {
      "sand::fast::grain::reco": {
        "min_energy_deposit": 1.0
      },
      "reqs": {
        "in_truth": "produced_truth"
      },
      "prods": {
        "out_grain": "produced_grain"
      }
    },
    {
      "sand::fast::matching": {},
      "reqs": {
        "in_grain": "produced_grain",
        "in_tracker": "produced_tracker"
      },
      "prods": {
        "out_assns": "produced_assns"
      }
    },
    {
      "sand::fast::vertexing": {},
      "reqs": {
        "in_truth": "produced_truth",
        "in_assns": "produced_assns",
        "in_grain": "produced_grain",
        "in_tracker": "produced_tracker"
      },
      "prods": {
        "out_common": "produced_common_vtx",
        "out_nd": "produced_nd_vtx"
      }
    },
    {
      "sand::fast::pid": {},
      "reqs": {
        "in_truth": "produced_truth",
        "in_common": "produced_common_vtx",
        "in_nd": "produced_nd_vtx"
      },
      "prods": {
        "out_common": "produced_common_pid",
        "out_nd": "produced_nd"
      }
    },
    {
      "sand::fast::neutrino": {},
      "reqs": {
        "in_truth": "produced_truth",
        "in_common": "produced_common_pid"
      },
      "prods": {
        "out_common": "produced_common"
      }
    },
    {
      "sand::test::fast_reco_test": {
        "tracker_min_energy_deposit": 0.04,
        "grain_min_energy_deposit": 1.0
      },
      "reqs": {
        "in_truth": "produced_truth",
        "in_common": "produced_common",
        "in_nd": "produced_nd"
      },
      "prods": {}
    },
    {
      "sand::common::gluckstern_smearing": {
        "intrinsic_pos_res_t" : 200e-3,
        "intrinsic_pos_res_l" : 2,
        "hit_energy_thr" : 250e-6,
        "b_field_magnitude" : 0.6
      },
      "reqs": {
        "in_nd": "produced_nd",
        "in_truth": "produced_truth"
      },
      "prods": {
        "out_nd": "produced_nd_smeared"
      }
    },
    {
      "sand::caf::caf_streamer": {
        "uri": "test/output_gluckstern_smeared.caf.root",
        "tree": "cafTree"
      },
      "write": ["produced_truth", "produced_common", "produced_nd_smeared"]
    }
  ]
}
