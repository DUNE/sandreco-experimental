{
    "ufw" : {
      "ufw-loglevel" : "debug",
      "ufw-basepath" : "/usr/local/share/sandreco/data",
      "ufw-ldpath" : ["/usr/local/lib64"],
      "ufw-env" : {}
    },
    "globals" : {
    },
    "contexts" : {
      "keys" :  [10,11,15,16],
      "locals" : {}
    },
    "run" : [
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/grain_point_clusters.root",
          "tree" : "point_clusters"
        },
        "read" : ["grain_point_clusters"]
      },
      {
        "sand::grain::fit_cluster" : {
          "fit_step_size" : 0.01,
          "use_weights" : true
        },
        "reqs" : {"point_clusters_in" : "grain_point_clusters"},
        "prods" : {"point_clusters_out" : "grain_fitted_point_clusters"}
      },
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/grain_fitted_clusters.root",
          "tree" : "point_clusters"
        },
        "write" : ["grain_fitted_point_clusters"]
      }
    ]
  }
