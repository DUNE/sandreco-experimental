{
  "ufw": {
    "ufw-loglevel": "debug",
    "ufw-basepath": "/usr/local/share/sandreco/data",
    "ufw-ldpath": [
      "/usr/local/lib64"
    ]
  },
  "globals": {
    "sand::root_tgeomanager": {
      "geometry": "test/SAND_opt3_DRIFT1.sand-events-in-sand_inner_volume.2.edep.root"
    },
    "sand::geoinfo": {}
    },
  "contexts": {
    "keys": 1,
    "locals": {
      "sand::edep_reader": {
        "uri": "test/SAND_opt3_DRIFT1.sand-events-in-sand_inner_volume.2.edep.root"
      }
    }
  },
  "run": [
    {
      "sand::ecal::optical_simulation": {
        "light_yield": 18.5
      },
      "reqs": {},
      "prods": {
        "pes": "ecal_photo_electrons"
      }
    },
    {
      "sand::ecal::full_digi": {
        "int_time_window": 30.0,
        "dead_time_window": 0.0,
        "pe_threshold": 2.5,
	"pmt_signal_length": 35.0,
	"samples": 10000,
	"pmt_sigma": 0.6,
	"pmt_tau": 4.0,
        "time_offset": 5.0,
        "saturation_level": 3200.0,
	"p0Sat": 5.59,
	"p1Sat": 0.04,
	"p2Sat": 1.22e-3
      },
      "reqs": {
        "pes": "ecal_photo_electrons"
      },
      "prods": {
        "digi": "ecal_digits",
        "waveforms": "ecal_waveforms"
      }
    },
    {
      "sand::root::tree_streamer": {
        "uri": "test/ecal_full_digi.root",
        "tree": "ecal_full_digi"
      },
      "write": [
        "ecal_digits",
        "ecal_waveforms"
      ]
    }
  ]
}
