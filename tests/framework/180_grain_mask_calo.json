{
    "ufw" : {
      "ufw-loglevel" : "debug",
      "ufw-basepath" : "/usr/local/share/sandreco/data",
      "ufw-ldpath" : ["/usr/local/lib64"],
      "ufw-env" : {}
    },
    "globals" : {
    },
    "contexts" : {
      "keys" :  [10,11,15,16],
      "locals" : {}
    },
    "run" : [
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/volumereco.root",
          "tree" : "recos"
        },
        "read" : ["grain_lightmap"]
      },
      {
        "sand::grain::mask_voxel_calorimetry" : {
          "calib_slope" : 1.1,
          "calib_intercept" : 0.3
        },
        "reqs" : {"photon_amplitudes" : "grain_lightmap"},
        "prods" : {"total_deposited_energy": "grain_total_energy"}
      },
      {
        "sand::root::tree_streamer" : { 
          "uri" : "test/grain_energy.root",
          "tree" : "energy"
        },
        "write" : [ "grain_total_energy" ]
      }
    ]
  }
