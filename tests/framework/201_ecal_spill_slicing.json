{
  "ufw": {
    "ufw-loglevel": "debug",
    "ufw-basepath": "/usr/local/share/sandreco/data",
    "ufw-ldpath": [
      "/usr/local/lib64"
    ]
  },
  "globals": {
    "sand::root_tgeomanager": {
      "geometry": "test/SAND_opt3_DRIFT1.sand-events-in-sand_inner_volume.2.edep.root"
    },
    "sand::geoinfo": {}
  },
  "contexts": {
    "keys": 2,
    "locals": {
      "sand::edep_reader": {
        "uri": "test/SAND_opt3_DRIFT1.sand-events-in-sand_inner_volume.2.edep.root"
      }
    }
  },
  "run": [
    {
      "sand::ecal::optical_simulation": {
        "light_yield": 18.5
      },
      "reqs": {},
      "prods": {
        "pes": "ecal_photo_electrons"
      }
    },
    {
      "sand::ecal::fast_digi": {
        "int_time_window": 30.0,
        "dead_time_window": 0.0,
        "pe_threshold": 2.5,
        "constant_fraction": 0.15
      },
      "reqs": {
        "pes": "ecal_photo_electrons"
      },
      "prods": {
        "digi": "ecal_digits"
      }
    },
    {
      "sand::ecal::spill_slicer": {
        "print_output": true
      },
      "reqs": {
        "digi": "ecal_digits"
      },
      "prods": {
        "timeranges": "ecal_timeranges"
      }
    }
  ]
}
