{
  "ufw": {
    "ufw-loglevel": "debug",
    "ufw-basepath": "/usr/local/share/sandreco/data",
    "ufw-ldpath": ["/usr/local/lib64"],
    "ufw-env": {}
  },
  "globals": {
    "sand::root_tgeomanager": {
      "geometry": "test/sand-spills.5.edep.root"
    }
  },
  "contexts": {
    "keys": 5,
    "locals": {
      "sand::edep_reader": {
        "uri": "test/sand-spills.5.edep.root"
      },
      "sand::genie_reader": {
        "uri": "test/sand-spills.5.edep.root"
      },
      "sand::spill_maps": {}
    }
  },
  "run": [
    {
      "sand::common::truth_filler": {},
      "reqs": {},
      "prods": {
        "out_truth_branch": "produced_truth"
      }
    },
    {
      "sand::tracker::fast_reco": {
        "min_energy_deposit": 0.04
      },
      "reqs": {
        "in_truth": "produced_truth"
      },
      "prods": {
        "out_tracker": "produced_tracker"
      }
    },
    {
      "sand::common::fast_matching": {},
      "reqs": {
        "in_truth": "produced_truth",
        "in_tracker": "produced_tracker"
      },
      "prods": {
        "out_common": "produced_common",
        "out_nd": "produced_nd"
      }
    },
    {
      "sand::test::fast_reco_test": {
        "min_energy_deposit": 0.04
      },
      "reqs": {
        "in_truth": "produced_truth",
        "in_common": "produced_common",
        "in_nd": "produced_nd"
      },
      "prods": {}
    },
    {
      "sand::caf::caf_streamer": {
        "uri": "test/output.caf.root",
        "tree": "cafTree"
      },
      "write": ["produced_truth", "produced_common", "produced_nd"]
    }
  ]
}
